{
  "StartNodeId": "nStart",
  "Nodes": {
    "nStart": {
      "Id": "nStart",
      "Type": "util.start",
      "Label": "Inicio",
      "Parameters": {
        "position": {
          "x": 720,
          "y": 40
        }
      }
    },
    "nLoadContrato": {
      "Id": "nLoadContrato",
      "Type": "doc.load",
      "Label": "Cargar contrato",
      "Parameters": {
        "path": "${input.filePath}",
        "mode": "auto",
        "docTipoCodigo": "CONTRATO_GENERAL",
        "connectionStringName": "DefaultConnection",
        "position": {
          "x": 720,
          "y": 160
        }
      }
    },
    "nIfTexto": {
      "Id": "nIfTexto",
      "Type": "control.if",
      "Label": "¿Documento con texto extraíble?",
      "Parameters": {
        "field": "input.hasText",
        "op": "==",
        "value": "true",
        "transform": "",
        "position": {
          "x": 720,
          "y": 300
        }
      }
    },
    "nTaskOperacionTexto": {
      "Id": "nTaskOperacionTexto",
      "Type": "human.task",
      "Label": "OPERACIONES - Validar ingreso del contrato",
      "Parameters": {
        "titulo": "Validar ingreso de contrato ${input.filename}",
        "descripcion": "Archivo=${input.filename}; extensión=${input.ext}; texto extraído=${input.textLen} caracteres. Confirmar que corresponde a un contrato, identificar el área solicitante y verificar que la versión recibida sea legible y completa. Completar APTO para continuar o NO_APTO para rechazar el ingreso.",
        "rol": "OPERACIONES",
        "usuarioAsignado": "",
        "estadoNegocioPendiente": "Pendiente de validación del ingreso",
        "deadlineMinutes": 480,
        "position": {
          "x": 390,
          "y": 470
        }
      }
    },
    "nIfOperacionTexto": {
      "Id": "nIfOperacionTexto",
      "Type": "control.if",
      "Label": "¿Ingreso validado?",
      "Parameters": {
        "field": "wf.tarea.nTaskOperacionTexto.resultado",
        "op": "==",
        "value": "apto",
        "transform": "",
        "position": {
          "x": 390,
          "y": 640
        }
      }
    },
    "nTaskOperacionSinTexto": {
      "Id": "nTaskOperacionSinTexto",
      "Type": "human.task",
      "Label": "OPERACIONES - Revisar documento sin texto",
      "Parameters": {
        "titulo": "Revisar contrato sin texto extraíble ${input.filename}",
        "descripcion": "El documento no contiene texto extraíble automáticamente. Archivo=${input.filename}; extensión=${input.ext}; advertencia=${input.warning}. Revisar visualmente que sea legible, confirmar que corresponde a un contrato y completar APTO para continuar con revisión manual o NO_APTO para rechazar el ingreso.",
        "rol": "OPERACIONES",
        "usuarioAsignado": "",
        "estadoNegocioPendiente": "Pendiente de revisión documental manual",
        "deadlineMinutes": 480,
        "position": {
          "x": 1050,
          "y": 470
        }
      }
    },
    "nIfOperacionSinTexto": {
      "Id": "nIfOperacionSinTexto",
      "Type": "control.if",
      "Label": "¿Documento manualmente validado?",
      "Parameters": {
        "field": "wf.tarea.nTaskOperacionSinTexto.resultado",
        "op": "==",
        "value": "apto",
        "transform": "",
        "position": {
          "x": 1050,
          "y": 640
        }
      }
    },
    "nTaskLegales": {
      "Id": "nTaskLegales",
      "Type": "human.task",
      "Label": "LEGALES - Revisar condiciones contractuales",
      "Parameters": {
        "titulo": "Revisión legal de contrato ${input.filename}",
        "descripcion": "Revisar partes, objeto, obligaciones, vigencia, rescisión, confidencialidad, responsabilidad, jurisdicción y condiciones de firma. El documento puede tener texto extraído=${input.hasText}; longitud=${input.textLen}. Completar APTO si puede continuar, NO_APTO si debe finalizar rechazado o usar Rechazar para devolverlo a la tarea humana anterior con observaciones.",
        "rol": "LEGALES",
        "usuarioAsignado": "",
        "estadoNegocioPendiente": "Pendiente de revisión legal",
        "deadlineMinutes": 2880,
        "position": {
          "x": 720,
          "y": 830
        }
      }
    },
    "nIfLegales": {
      "Id": "nIfLegales",
      "Type": "control.if",
      "Label": "¿Legales aprobó?",
      "Parameters": {
        "field": "wf.tarea.nTaskLegales.resultado",
        "op": "==",
        "value": "apto",
        "transform": "",
        "position": {
          "x": 720,
          "y": 1000
        }
      }
    },
    "nTaskAdmFin": {
      "Id": "nTaskAdmFin",
      "Type": "human.task",
      "Label": "ADM_FIN - Revisar impacto económico",
      "Parameters": {
        "titulo": "Revisión económica de contrato ${input.filename}",
        "descripcion": "Validar importes, moneda, impuestos, forma de pago, actualización de precios, garantías, penalidades y disponibilidad presupuestaria. Legales ya aprobó el documento. Completar APTO para continuar, NO_APTO para finalizar rechazado o usar Rechazar para devolverlo a Legales con observaciones.",
        "rol": "ADM_FIN",
        "usuarioAsignado": "",
        "estadoNegocioPendiente": "Pendiente de revisión económica",
        "deadlineMinutes": 2880,
        "position": {
          "x": 480,
          "y": 1170
        }
      }
    },
    "nIfAdmFin": {
      "Id": "nIfAdmFin",
      "Type": "control.if",
      "Label": "¿Administración aprobó?",
      "Parameters": {
        "field": "wf.tarea.nTaskAdmFin.resultado",
        "op": "==",
        "value": "apto",
        "transform": "",
        "position": {
          "x": 480,
          "y": 1340
        }
      }
    },
    "nTaskDireccion": {
      "Id": "nTaskDireccion",
      "Type": "human.task",
      "Label": "DIR_GENERAL - Autorizar contrato",
      "Parameters": {
        "titulo": "Autorización final de contrato ${input.filename}",
        "descripcion": "El contrato fue validado por Operaciones, Legales y Administración. Revisar el riesgo y la conveniencia general antes de autorizar su firma. Completar APTO para aprobar, NO_APTO para cerrar rechazado o usar Rechazar para devolverlo a Administración con observaciones.",
        "rol": "DIR_GENERAL",
        "usuarioAsignado": "",
        "estadoNegocioPendiente": "Pendiente de autorización final",
        "deadlineMinutes": 2880,
        "position": {
          "x": 300,
          "y": 1510
        }
      }
    },
    "nIfDireccion": {
      "Id": "nIfDireccion",
      "Type": "control.if",
      "Label": "¿Dirección autorizó?",
      "Parameters": {
        "field": "wf.tarea.nTaskDireccion.resultado",
        "op": "==",
        "value": "apto",
        "transform": "",
        "position": {
          "x": 300,
          "y": 1680
        }
      }
    },
    "nNotifyAprobado": {
      "Id": "nNotifyAprobado",
      "Type": "util.notify",
      "Label": "Notificar contrato aprobado",
      "Parameters": {
        "tipo": "sistema",
        "canal": "sistema",
        "nivel": "info",
        "destinoTipo": "rol",
        "prioridad": "normal",
        "rolDestino": "OPERACIONES",
        "destino": "OPERACIONES",
        "asunto": "Contrato aprobado para firma",
        "mensaje": "El contrato ${input.filename} fue aprobado por Operaciones, Legales, Administración y Dirección General. Instancia=${wf.instanceId}. Puede continuar el circuito externo de firma y archivo.",
        "urlAccion": "",
        "position": {
          "x": 530,
          "y": 1850
        }
      }
    },
    "nNotifyRechazado": {
      "Id": "nNotifyRechazado",
      "Type": "util.notify",
      "Label": "Notificar contrato no aprobado",
      "Parameters": {
        "tipo": "sistema",
        "canal": "sistema",
        "nivel": "warn",
        "destinoTipo": "rol",
        "prioridad": "alta",
        "rolDestino": "OPERACIONES",
        "destino": "OPERACIONES",
        "asunto": "Contrato no aprobado",
        "mensaje": "El contrato ${input.filename} no fue aprobado. Último resultado=${wf.tarea.resultado}; instancia=${wf.instanceId}. Revisar la instancia y las observaciones registradas.",
        "urlAccion": "",
        "position": {
          "x": 1110,
          "y": 1170
        }
      }
    },
    "nEndAprobado": {
      "Id": "nEndAprobado",
      "Type": "util.end",
      "Label": "Fin - Contrato aprobado",
      "Parameters": {
        "estadoNegocio": "Contrato aprobado para firma",
        "position": {
          "x": 530,
          "y": 2020
        }
      }
    },
    "nEndRechazado": {
      "Id": "nEndRechazado",
      "Type": "util.end",
      "Label": "Fin - Contrato rechazado",
      "Parameters": {
        "estadoNegocio": "Contrato rechazado",
        "position": {
          "x": 1110,
          "y": 1340
        }
      }
    }
  },
