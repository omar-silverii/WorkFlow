        "urlAccion": "",
        "position": {
          "x": 1330,
          "y": 1540
        }
      }
    },
    "nNotifyNoResuelto": {
      "Id": "nNotifyNoResuelto",
      "Type": "util.notify",
      "Label": "Notificar acción correctiva no resuelta",
      "Parameters": {
        "tipo": "sistema",
        "canal": "sistema",
        "nivel": "error",
        "destinoTipo": "rol",
        "prioridad": "alta",
        "rolDestino": "DIR_GENERAL",
        "destino": "DIR_GENERAL",
        "asunto": "Reclamo no resuelto después de acción correctiva",
        "mensaje": "La acción correctiva no pudo resolver el reclamo asociado a ${input.filename}. Último resultado=${wf.tarea.resultado}; instancia=${wf.instanceId}. El caso finaliza registrado como no resuelto y requiere seguimiento externo.",
        "urlAccion": "",
        "position": {
          "x": 1060,
          "y": 1880
        }
      }
    },
    "nNotifyIngresoRechazado": {
