        "tipo": "sistema",
        "canal": "sistema",
        "nivel": "warn",
        "destinoTipo": "rol",
        "prioridad": "alta",
        "rolDestino": "OPERACIONES",
        "destino": "OPERACIONES",
        "asunto": "Reclamo cerrado sin acción adicional",
