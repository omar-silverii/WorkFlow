<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<!-- Canal físico de ingreso. Cada archivo es reclamado y registrado antes de elegir workflow. -->
		<add key="WatchFolder.Input" value="C:\WorkflowStudio\Inbox\General" />
		<add key="WatchFolder.Processing" value="C:\WorkflowStudio\Processing\General" />
		<add key="WatchFolder.Processed" value="C:\WorkflowStudio\Processed\General" />
		<add key="WatchFolder.Error" value="C:\WorkflowStudio\Error\General" />
		<add key="WatchFolder.LogFolder" value="C:\WorkflowStudio\Logs\Dispatcher" />

		<!-- fix76: el workflow se resuelve mediante WF_IngresoRuta o por decisión humana. -->
		<add key="Ingress.Router.Enabled" value="true" />
		<add key="Ingress.ChannelCode" value="GENERAL" />

		<!-- Compatibilidad fix75: solo agregar Workflow.Nombre si Router.Enabled=false. -->
		<!-- <add key="Workflow.Nombre" value="NOMBRE_UNICO_DEL_WORKFLOW" /> -->

		<!-- Contrato de entrada del workflow: doc.load usa ${input.filePath}. -->
		<add key="Workflow.InputField" value="filePath" />

		<!-- Filtro y polling. Ajustar el patrón si el canal admite otros formatos. -->
		<add key="WatchFolder.Pattern" value="*.*" />
		<add key="WatchFolder.PollSeconds" value="2" />
		<add key="WatchFolder.StableChecks" value="2" />
		<add key="WatchFolder.StableDelayMs" value="500" />

		<!-- El archivo solo sale de Processing al finalizar o fallar la instancia. -->
		<add key="WatchFolder.MoveAfter" value="true" />
		<add key="ClientSettingsProvider.ServiceUri" value="" />
	</appSettings>

	<connectionStrings>
		<add name="DefaultConnection" connectionString="Data Source=OMARD\SQLEXPRESS;Initial Catalog=Workflow;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
	</connectionStrings>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Identity.Client" publicKeyToken="0a613f4dd989e8ae" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.78.0.0" newVersion="4.78.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>
